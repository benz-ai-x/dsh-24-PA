{
  "name": "@benz-ai-x/dsh-24pa",
  "version": "0.2.1-alpha.1.4",
  "description": "24私助（24PA）: Feishu-backed personal assistant as a dsh workspace bundle.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/tools.js",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "feishu-setup.md",
    "wecom-setup.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "prepare": "node scripts/link-peer.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "pg": "8.23.1",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-schedule": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-schedule": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.11.10",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "feishu",
    "lark",
    "larksuite",
    "personal-assistant",
    "ai-assistant",
    "assistant",
    "agent",
    "chatbot",
    "reminders",
    "tasks",
    "calendar",
    "handwriting",
    "postgresql",
    "24pa"
  ],
  "homepage": "https://github.com/benz-ai-x/dsh-24-PA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benz-ai-x/dsh-24-PA.git",
    "directory": "packages/24pa"
  },
  "bugs": {
    "url": "https://github.com/benz-ai-x/dsh-24-PA/issues"
  }
}