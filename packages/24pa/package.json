{
  "name": "@benz-ai-x/dsh-24pa",
  "version": "0.2.1-rc.3.2",
  "description": "24私助（24PA）: Feishu-backed personal assistant as a dsh workspace bundle.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/tools.js",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "feishu-setup.md",
    "wecom-setup.md",
    "melo",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "preset:sync": "node scripts/sync-preset.mjs",
    "preset:check": "node scripts/sync-preset.mjs --check",
    "prepare": "node scripts/link-peer.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "pg": "8.23.1",
    "saxes": "6.0.0",
    "sharp": "0.35.3",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-schedule": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-schedule": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.3",
    "@types/node": "^22.10.0",
    "@types/pg": "8.11.10",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "happy-dom": "20.8.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "feishu",
    "lark",
    "larksuite",
    "personal-assistant",
    "ai-assistant",
    "assistant",
    "agent",
    "chatbot",
    "reminders",
    "tasks",
    "calendar",
    "handwriting",
    "postgresql",
    "24pa"
  ],
  "homepage": "https://github.com/benz-ai-x/dsh-24-PA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benz-ai-x/dsh-24-PA.git",
    "directory": "packages/24pa"
  },
  "bugs": {
    "url": "https://github.com/benz-ai-x/dsh-24-PA/issues"
  }
}
