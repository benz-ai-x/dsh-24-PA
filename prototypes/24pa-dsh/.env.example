# Copy to your own private environment file on the server, then export these values.
# Do not commit actual secrets. Use the same Feishu app for the bot and CLI profile.
PA24_MODE=feishu
PA24_LARK_PROFILE=default
PA24_OWNER_OPEN_ID=ou_replace_with_your_open_id
PA24_FOLDER_TOKEN=replace_with_disposable_folder_token
PA24_TASKLIST_ID=replace_with_disposable_tasklist_guid
PA24_FEISHU_APP_ID=cli_replace_with_your_app_id
PA24_FEISHU_APP_SECRET=replace_with_your_app_secret
# Optional: path to an already built source checkout CLI (only for npm run prototype).
# PA24_DSH_CLI=/opt/deepseek-harness/apps/cli/lib/bin.js
# PA24_PORT=3210
